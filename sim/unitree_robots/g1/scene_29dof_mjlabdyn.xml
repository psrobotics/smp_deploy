<mujoco model="g1_29dof scene">
  <include file="g1_29dof_mjlabdyn.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <!-- The "white" theme: a white studio look — uniform white skybox, a white
       floor marked only by black checker edges, no reflectance. The robot is
       then the only coloured thing in frame, which photographs well and makes
       a recording legible. offwidth/offheight are set for 1080p offscreen
       capture. -->
  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.2 0.2 0.2" specular="0.1 0.1 0.1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
